# Copy this file to .env.local for local development.
# Never commit real values — .env*.local is already git-ignored.

# 1. Create a dedicated project at https://supabase.com (one per site instance).
# 2. Open Project Settings > API and copy the values below.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Your deployed site URL. Used for Open Graph / sitemap / robots.
# On Netlify this is set automatically via the URL env var; override here if needed.
# NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
